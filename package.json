{
  "name": "evo-afterdark",
  "displayName": "EVO Afterdark",
  "description": "Deep cosmic blacks with electric cyan, ultraviolet and neon magenta accents. Two dark themes, EVO | Neon and EVO | Void, based on Evro Dark by EvroHQ.",
  "version": "1.0.0",
  "publisher": "messified",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/messified/EVO"
  },
  "galleryBanner": {
    "color": "#0B1020",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "keywords": [
    "theme",
    "dark theme",
    "neon",
    "cyberpunk",
    "evo afterdark",
    "evro dark"
  ],
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node scripts/build-themes.js",
    "test": "node scripts/validate-themes.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1"
  },
  "contributes": {
    "themes": [
      {
        "label": "EVO | Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/evo-neon-color-theme.json"
      },
      {
        "label": "EVO | Void",
        "uiTheme": "vs-dark",
        "path": "./themes/evo-void-color-theme.json"
      }
    ]
  }
}
